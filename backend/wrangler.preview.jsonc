{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "paper-adventure-preview-v2",
  "main": "./preview-deploy-worker.mjs",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "assets": {
    "directory": "../dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
