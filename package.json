{
  "name": "paper-adventure-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-static-pages.mjs && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:backend": "node --test backend/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:static": "node --test tests/static-pages.test.mjs tests/analytics-route.test.mjs tests/route-links.test.mjs tests/order-package.test.mjs",
    "package:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-preview.ps1"
  },
  "dependencies": {
    "@fontsource/bree-serif": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
